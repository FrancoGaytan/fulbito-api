# =============================================================
# Base Server Config
# =============================================================
NODE_ENV=development
PORT=3000

# Mongo
MONGODB_URI=mongodb://localhost:27017/fulbito
MONGODB_DBNAME=fulbito

# JWT / Auth
# Generate a long random string for production.
JWT_SECRET=change_this_in_prod_please

# =============================================================
# Password Reset Flow
# =============================================================
# Minutes the reset code is valid
RESET_CODE_TTL_MINUTES=15
# Min interval (ms) to allow requesting a new reset email for same user
RESET_CODE_THROTTLE_MS=60000

# =============================================================
# Email Sending (Resend)
# Set EMAIL_PROVIDER=console to disable real sending (logs only)
# =============================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
# After verifying domain (see section below) set a real sender:
EMAIL_FROM=no-reply@fulbitoweb.com

# =============================================================
# Optional Feature Flags
# =============================================================
USE_GEMINI_TEAMS=false
GEMINI_API_KEY=

# =============================================================
# DNS SETUP FOR RESEND (Domain: fulbitoweb.com)
# (Do NOT paste these into the .env, they go in your DNS provider)
# Create the following DNS TXT records + DMARC:
# 1) DKIM:
#    Type: TXT
#    Host/Name: resend._domainkey
#    Value: p=MI........QAB   (the p=... value provided by Resend, one line)
# 2) SPF:
#    Type: TXT
#    Host/Name: @  (root)
#    Value: v=spf1 include:amazonses.com ~all
# 3) DMARC:
#    Type: TXT
#    Host/Name: _dmarc
#    Value: v=DMARC1; p=none;
# (MX usually NOT required for basic outbound only. If Resend asks, follow UI.)
# After propagation (5-30 min), click Restart/Verify in Resend UI.
# Then test /request-reset-code.
# In development you can temporarily set EMAIL_PROVIDER=console to avoid emails.

